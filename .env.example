# Copie este archivo como .env (nunca suba .env a Git)
ENVIRONMENT=development

# Local: SQLite. En Render se inyecta automáticamente la URL de PostgreSQL.
DATABASE_URL=sqlite:///./asesor.db
# DATABASE_URL=postgresql://usuario:password@host:5432/dbname

# Genere una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambie-esta-clave
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=*

# Motor de IA: "mock" (determinista, sin costo) u "openai" (cualquier API compatible OpenAI)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_FALLBACK_TO_MOCK=true

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

INIT_DB_ON_STARTUP=true
SEED_DEMO_DATA=true
DEMO_PASSWORD=Demo2026*
